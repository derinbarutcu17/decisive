{
  "name": "decisive",
  "version": "1.0.0",
  "description": "Local-first decision matrix for macOS",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit",
    "test:unit": "node test/api.test.mjs && node test/vercel-config.test.mjs && node test/approved-scope-contract.cjs && node test/label-motion-regression.cjs",
    "test:e2e": "node scripts/e2e.cjs",
    "verify": "npm run test:unit && npm run test:e2e",
    "app": "electron .",
    "capture:readme": "electron scripts/capture-readme-shots.cjs",
    "dist": "electron-builder --mac dir",
    "release:preflight": "node scripts/release-preflight.cjs",
    "release:artifacts": "node scripts/release-preflight.cjs --artifacts"
  },
  "build": {
    "appId": "com.derin.eisenhower",
    "productName": "Decisive",
    "asar": false,
    "files": [
      "main.cjs",
      "server.js",
      "examples/demo-data.json",
      "index.html",
      "style.css",
      "app.js",
      "ascii-background.js",
      "metal-shader.js",
      "vendor/asciify-engine.js",
      "decisive-mark.png",
      "fonts/Inter-Variable.ttf"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "asciify-engine": "^1.0.118"
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
